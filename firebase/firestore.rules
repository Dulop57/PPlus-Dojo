rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/records/{recordId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['key', 'kind', 'payload', 'version', 'updatedAt'])
        && request.resource.data.kind in ['progress', 'reviews', 'settings']
        && request.resource.data.key is string && request.resource.data.key.size() < 20000
        && request.resource.data.payload is string && request.resource.data.payload.size() < 200000
        && request.resource.data.version.keys().hasOnly(['at', 'revision'])
        && request.resource.data.version.at is int && request.resource.data.version.at >= 0
        && request.resource.data.version.revision is string && request.resource.data.version.revision.size() == 36
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
